# ══════════════════════════════════════════════════════════════════════════════
# Caddy — bloques de hilvapay para agregar al /etc/caddy/Caddyfile de la VPS.
#
# Este bloque se importa a mano (copy-paste), como el de dashboard-admin: no usa
# el snippet (funnel) de los funnels a propósito, porque ese proxea a dos
# puertos y pinnea rutas del embudo que no existen acá.
#
# DOS bloques de sitio, MISMO backend (127.0.0.1:3020): la app es un solo
# proceso de Next que sirve el panel y los links de pago a la vez, y decide
# cuál mostrar mirando el host (middleware.ts, sección "Dos dominios, un
# proceso"). Por eso `header_up Host` y `header_up X-Forwarded-Host` son
# OBLIGATORIOS en los dos bloques: si Caddy no manda X-Forwarded-Host con el
# dominio real, `hostDe()` en el middleware no tiene con qué distinguir
# hilvapay.hilvanapp.com de pay.hilvanapp.com y todo cae al mismo lado —
# devolviendo 404 en el otro dominio (ver middleware.ts, PANEL_HOST/PAGOS_HOST).
#
# Validar antes de recargar:  caddy validate --config /etc/caddy/Caddyfile
# Recargar:                    sudo systemctl reload caddy
# ══════════════════════════════════════════════════════════════════════════════

hilvapay.hilvanapp.com {
	# El wildcard *.hilvanapp.com ya cubre este host: no hace falta emitir un cert nuevo.
	tls /etc/caddy/certs/hilvapay.pem /etc/caddy/certs/hilvapay.key

	encode zstd gzip

	# El panel muestra ventas y el estado de la conexión con Whop: no se
	# cachea. El `defer` NO es opcional: sin él Caddy setea el header antes de
	# correr el proxy y la respuesta sale con DOS Cache-Control (uno de Caddy,
	# otro del `headers()` de next.config.mjs o de las rutas de /admin).
	header {
		defer
		Cache-Control "no-store, must-revalidate"
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	reverse_proxy 127.0.0.1:3020 {
		header_up X-Real-IP {client_ip}
		# El middleware separa los dos dominios por header, no por el Host que
		# ve el proceso: sin esto, pierde la distinción y 404-ea todo.
		header_up Host hilvapay.hilvanapp.com
		header_up X-Forwarded-Host hilvapay.hilvanapp.com
	}

	log {
		output file /var/log/caddy/hilvapay.log {
			roll_size 20mb
			roll_keep 7
			roll_keep_for 168h
		}
	}
}

pay.hilvanapp.com {
	tls /etc/caddy/certs/hilvapay.pem /etc/caddy/certs/hilvapay.key

	encode zstd gzip

	# Este dominio va a estar en anuncios y en links compartidos (WhatsApp,
	# redes): no se indexa y no se cachea. Cada /pagos/<slug> depende de una
	# orden y de un embed vivo de Whop — servir una versión vieja desde caché
	# le mostraría a un comprador un checkout que ya no corresponde.
	header {
		defer
		Cache-Control "no-store, must-revalidate"
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	reverse_proxy 127.0.0.1:3020 {
		header_up X-Real-IP {client_ip}
		# Mismo motivo que arriba: sin X-Forwarded-Host el middleware no puede
		# saber que esto es pay.hilvanapp.com y no hilvapay.hilvanapp.com.
		header_up Host pay.hilvanapp.com
		header_up X-Forwarded-Host pay.hilvanapp.com
	}

	log {
		output file /var/log/caddy/pay.log {
			roll_size 20mb
			roll_keep 7
			roll_keep_for 168h
		}
	}
}
