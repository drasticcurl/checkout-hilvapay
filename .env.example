# ─────────────────────────────────────────────────────────────────────────────
# Checkout propio sobre Whop — variables de entorno
#
# Copiar a .env.local para desarrollo. En la VPS el archivo vivo es
# /srv/hilvapay/shared/.env.production, con chmod 600, y deploy.sh lo copia
# dentro de la release.
# NINGUNA de estas se commitea con valor real.
# ─────────────────────────────────────────────────────────────────────────────

# ── Whop ─────────────────────────────────────────────────────────────────────

# Company API key. Dashboard → Developer → Company API keys → Create.
# Dejar la lista de IPs vacía y MARCAR LAS 22 PERMISOS. No recortar la lista:
# POST /payments por sí solo exige 13 permisos y POST /checkout_configurations
# otros 5; recortar produce 403 que no dicen qué falta.
WHOP_API_KEY=

# Signing secret del webhook (Developer → Webhooks → columna Secret). Empieza
# con `ws_`. Se guarda TAL CUAL: sin sacarle el prefijo y sin volver a
# codificarlo en base64.
#
# La doc de Whop, en "Verify without an SDK", dice que la clave del HMAC es ese
# string literal. OJO: `standardwebhooks` por defecto hace base64.decode() del
# secret, así que con esta clave NO valida nunca. Por eso la verificación está
# escrita a mano en lib/whop-webhook.ts.
WHOP_WEBHOOK_SECRET=

# ID de la company que recibe las ventas (biz_...). Va como `account_id` en cada
# POST /payments.
WHOP_COMPANY_ID=

# Base de la API. Sandbox: https://sandbox-api.whop.com/api/v1
WHOP_API_BASE=https://api.whop.com/api/v1

# Se manda como header `Api-Version-Date` en TODAS las llamadas. Pinnearlo es lo
# que evita que un cambio de la API rompa producción sin aviso.
#
# VERIFICADO el 2026-09-10 contra la API real: `2026-08-21-1` responde 200.
#
# El formato no es consistente en la doc de Whop: los snippets del SDK muestran
# `2026-08-21-1` (con sufijo), la referencia de headers `2026-09-09` y el
# quickstart `2026-07-01`. Si alguna vez hay que cambiarlo, `configurar-env.sh`
# prueba los formatos conocidos y se queda con el que responda.
#
# Además es parte de la clave de idempotencia del lado de Whop: si cambia,
# un reintento con la misma Idempotency-Key deja de replayarse.
WHOP_API_VERSION_DATE=2026-08-21-1

# `production` o `sandbox`. Solo controla qué se le pasa al embed del browser.
# La API la decide WHOP_API_BASE. Los plan IDs de sandbox son DISTINTOS a los de
# producción: mezclarlos da errores confusos.
NEXT_PUBLIC_WHOP_ENV=sandbox

# ── Planes ───────────────────────────────────────────────────────────────────
# SOLO para el seed y para la verificación de configurar-env.sh. La app lee los
# plan_id de la tabla `productos`, no del entorno.
PLAN_FRONT=
PLAN_UPSELL_1=
PLAN_UPSELL_2=
PLAN_UPSELL_3=

# ── App ──────────────────────────────────────────────────────────────────────

# Postgres. En la VPS es el paquete nativo de Ubuntu en 127.0.0.1:5432 con su
# base propia; no hace falta pooler ni SSL porque la app es un proceso largo de
# PM2 que reusa las conexiones del pool.
DATABASE_URL=

# Dónde se guardan las imágenes de producto subidas desde el panel.
#
# TIENE que estar FUERA de la release: el deploy arma cada release desde git y
# hace un swap de `current`, así que lo que quede adentro desaparece en el
# próximo deploy. En la VPS es /srv/hilvapay/shared/uploads.
# En desarrollo, si no se define, usa ./uploads (está en el .gitignore).
UPLOADS_DIR=

# Dominio público del checkout. Sin barra final.
NEXT_PUBLIC_BASE_URL=https://pay.hilvanapp.com

# ── Panel admin ──────────────────────────────────────────────────────────────

# Contraseña del panel. Es el único factor de auth, así que va larga y random.
PANEL_PASSWORD=

# Secreto con el que se firma la cookie de sesión del panel. Si falta, se usa
# PANEL_PASSWORD — pero entonces cambiar la contraseña invalida las sesiones.
# Mismo formato de token que el dashboard-admin (`id.ts.hmac`).
PANEL_SESSION_SECRET=

# Clave con la que se cifran los secretos que el panel guarda en la base. Hoy la
# usa una sola cosa: la API key de Whop que se puede rotar desde
# /admin/conexion sin entrar por SSH.
#
#   openssl rand -hex 32
#
# Van 32 bytes exactos, en hex (64 caracteres) o en base64. Cualquier otro largo
# se rechaza en vez de derivarse: derivar aceptaría "1234" como clave sin decirlo.
#
# NO es crítica para arrancar. Si falta, el servicio funciona igual leyendo las
# credenciales de las variables de abajo; lo único que no se puede hacer es
# guardar una key nueva desde el panel, y la pantalla lo dice.
#
# Perderla no rompe el cobro (se sigue con el entorno), pero deja ilegible lo que
# ya estaba guardado en la base. Cambiarla equivale a descartar ese override.
CONFIG_ENCRYPTION_KEY=

# ── Salida hacia el dashboard-admin ──────────────────────────────────────────

# URL del endpoint de ingesta del panel que ya existe.
PANEL_INGEST_URL=https://tu-panel/api/ingest

# Ingest key del funnel en el panel (la que valida `funnels.ingest_key_hash`).
# Va como `Authorization: Bearer <key>`.
PANEL_INGEST_KEY=

# URL del endpoint NUEVO de venta con monto (POST /api/webhooks/checkout-propio,
# T02 en dashboard-admin). NO es lo mismo que PANEL_INGEST_URL: ese endpoint
# (/api/ingest) es tracking de embudo puro y NUNCA crea una fila en `orders`
# con monto (D1 del plan panel-y-capi) — sin esta URL/key aparte, la venta del
# checkout propio no aparece en reportes de facturación/comisiones/costos,
# solo en el embudo. Los dos POSTs salen del mismo cron (app/api/cron/salidas)
# pero van a destinos distintos.
PANEL_VENTAS_URL=

# Key de autenticación del endpoint anterior. Es un secreto DISTINTO de
# PANEL_INGEST_KEY (dos endpoints, dos propósitos, dos keys — no se reusan).
PANEL_VENTAS_KEY=

# ── Meta Conversions API (T04, PANEL-Y-CAPI) ────────────────────────────────

# Pixel ID de Meta. Acepta VARIOS valores separados por coma para mandar el
# mismo evento a más de un pixel (emparejados por posición con
# META_CAPI_TOKEN, ver lib/capi.ts getCapiTargets). P-05: se recomienda usar
# el MISMO Pixel ID que ya usa testfunnel/lib/tracking.ts, salvo que se decida
# lo contrario.
#
# Sin esta variable (o sin META_CAPI_TOKEN), el envío a CAPI es un no-op
# silencioso: el cron de salidas sigue funcionando normal para el resto de
# los pasos (panel, email).
META_PIXEL_ID=

# Token de acceso de CAPI para el pixel de arriba (System User token de Meta
# Business Manager). Si META_PIXEL_ID tiene varios valores separados por
# coma, este también, en el mismo orden.
META_CAPI_TOKEN=

# Dominio público del checkout, usado como `event_source_url` en el evento
# Purchase que se manda a Meta CAPI (lib/capi.ts). Sin barra final.
# Default si falta: https://pay.hilvanapp.com (P-03, a confirmar contra el
# dominio verificado en Meta Business Manager).
CHECKOUT_BASE_URL=https://pay.hilvanapp.com

# ── Cron ─────────────────────────────────────────────────────────────────────

# Protege /api/cron/*. El crontab de la VPS lo manda como
# `Authorization: Bearer <secret>` (ver deploy/cron.hilvapay).
#
# También habilita el modo detalle de GET /api/health: con este Bearer el health
# check dice QUÉ falta (base, migración o variable), y sin él solo dice si está
# sano. deploy.sh lo usa para loguear el diagnóstico antes de revertir.
CRON_SECRET=

# ── Alertas por Telegram ─────────────────────────────────────────────────────
#
# Nada de esto es obligatorio para cobrar: sin TELEGRAM_BOT_TOKEN el vigilante
# detecta los problemas igual, los anota en /var/log/hilvapay/vigilar.log y no
# los puede avisar. Pero es la diferencia entre enterarse de una disputa en 15
# minutos y enterarse cuando llega el contracargo.

# Token del bot. @BotFather → /newbot → copiar el token completo.
TELEGRAM_BOT_TOKEN=

# El chat que recibe TODAS las alertas, siempre. Es el piso: no se puede borrar
# desde el panel, y funciona con la tabla de destinatarios vacía.
#
# Para conseguirlo: hablale al bot y mandale /id, o mirá
# https://api.telegram.org/bot<TOKEN>/getUpdates después de escribirle.
# Los ids de grupo son NEGATIVOS y los de canal empiezan con -100.
TELEGRAM_CHAT_ID_ADMIN=

# Secreto que autentica a Telegram contra nosotros. Se elige libremente y se
# registra una sola vez, junto con la URL:
#
#   curl -X POST "https://api.telegram.org/bot<TOKEN>/setWebhook" \
#     -d "url=https://pay.hilvanapp.com/api/telegram/webhook" \
#     -d "secret_token=<TELEGRAM_WEBHOOK_SECRET>"
#
# SIN esta variable, POST /api/telegram/webhook devuelve 404 y el bot no
# responde nada: nace inerte, no abierto.
TELEGRAM_WEBHOOK_SECRET=

# El código que hay que mandarle al bot para darse de alta (`/alta <código>`).
# Sin esto, cualquiera que encuentre el bot se suscribe a los avisos de venta,
# que incluyen montos y emails de compradores.
TELEGRAM_CODIGO_REGISTRO=

# Poner en 0 para dejar de recibir el aviso de cada venta y quedarse solo con las
# fallas. Viene encendido: un canal que solo trae malas noticias se silencia, y
# un canal silenciado no sirve para las que sí importan.
TELEGRAM_AVISAR_VENTAS=1

# ── Separación de dominios ───────────────────────────────────────────────────
# Los dos hosts corren sobre el MISMO proceso y middleware.ts los separa. Si
# faltan, no se bloquea nada: un deploy al que le falta una variable tiene que
# quedar accesible para poder arreglarlo, no tapiado.
PANEL_HOST=hilvapay.hilvanapp.com
PAGOS_HOST=pay.hilvanapp.com
